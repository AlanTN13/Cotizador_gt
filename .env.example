# Server only. Configure separately for the approved Preview branch.
OPENAI_API_KEY=
COURIER_OPENAI_MODEL=gpt-4.1-mini
COURIER_REGISTRY_URL=
COURIER_REGISTRY_SECRET=
COURIER_REFERENCE_MODE=false

# n8n Courier V1 — SERVER ONLY; configure on Preview, never NEXT_PUBLIC_.
N8N_COURIER_WEBHOOK_URL=https://nexops.app.n8n.cloud/webhook-test/globaltrip-courier-v1
# Exact Name field of the Header Auth credential configured by Joaco in n8n:
N8N_COURIER_HEADER_NAME=
# Exact Value of that credential (secret, never commit):
N8N_COURIER_WEBHOOK_SECRET=
